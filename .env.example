# Environment Variables Template
PROJECT_NAME="AI Crop Stress Detection and Farmer Alert System"
SECRET_KEY="replace_this_with_a_secure_random_key_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (PostgreSQL in production, SQLite in local development fallback)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crop_health_db
DATABASE_URL=sqlite:///./backend/data/crop_health.db

# Weather API (OpenWeatherMap)
OPENWEATHER_API_KEY=""

# Mandi / Market Prices API (Data.gov.in)
DATA_GOV_API_KEY=""

# Kisan Bot Language Model Integration
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# SMS Notifications (Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Email Notifications (SMTP)
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
