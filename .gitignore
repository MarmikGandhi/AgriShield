# ==========================================
# AgriShield AI — Root .gitignore
# ==========================================

# --- 1. Python & Virtual Environments ---
venv/
backend/venv/
env/
.venv/
ENV/
env.bak/
venv.bak/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
*.log

# --- 2. Node.js & Frontend Build Outputs ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- 3. Secrets & Environment Variables ---
.env
backend/.env
frontend/.env.local
frontend/.env.*.local
*.pem
*.key
*.cert

# --- 4. Large Datasets (Dozens of Gigabytes) ---
datasets/
backend/data/raw/
backend/data/processed/
backend/data/manifests/raw/
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# --- 5. Local Database & Test Uploads ---
*.db
*.sqlite
*.sqlite3
backend/data/*.db
backend/data/crop_health.db
backend/crop_stress.db
backend/data/uploads/*
!backend/data/uploads/.gitkeep
backend/data/static/*
!backend/data/static/.gitkeep

# --- 6. OS & IDE Configuration ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# --- 7. Large AI Model Checkpoints (Optional) ---
# Note: GitHub has a 100MB per-file hard limit.
# Our models are under 35MB each:
# - efficientnet_b0_best.pth (19 MB)
# - mobilenet_v3_best.pth (6.3 MB)
# - unet_plantseg_best.pth (31 MB)
# If you want to host weights on GitHub Releases or Hugging Face, uncomment the lines below:
# backend/models/classification/*.pth
# backend/models/segmentation/*.pth
